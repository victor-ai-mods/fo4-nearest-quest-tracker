{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static"
      }
    },
    {
      "name": "vs",
      "inherits": "base"
    },
    {
      "name": "ae",
      "inherits": "base",
      "cacheVariables": {
        "NQT_AE": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "vs",
      "configuration": "Release"
    },
    {
      "name": "debug",
      "configurePreset": "vs",
      "configuration": "Debug"
    },
    {
      "name": "ae-release",
      "configurePreset": "ae",
      "configuration": "Release"
    },
    {
      "name": "ae-debug",
      "configurePreset": "ae",
      "configuration": "Debug"
    }
  ]
}
