{
    "modName": "NearestQuestTracker",
    "displayName": "$NQT_MOD_NAME",
    "minMcmVersion": 2,
    "pluginRequirements": [
        "NearestQuestTracker.esp"
    ],
    "content": [
        {
            "type": "text",
            "text": "$NQT_ABOUT"
        },
        {
            "type": "spacer"
        },
        {
            "type": "section",
            "text": "$NQT_SEC_WINDOW"
        },
        {
            "type": "button",
            "text": "$NQT_OPEN_WINDOW",
            "help": "$NQT_OPEN_WINDOW_HELP",
            "action": {
                "type": "CallFunction",
                "form": "NearestQuestTracker.esp|800",
                "scriptName": "NQT_MainScript",
                "function": "OpenWindowFromMenu",
                "params": []
            }
        },
        {
            "type": "button",
            "text": "$NQT_GIVE_ITEM",
            "help": "$NQT_GIVE_ITEM_HELP",
            "action": {
                "type": "CallFunction",
                "form": "NearestQuestTracker.esp|800",
                "scriptName": "NQT_MainScript",
                "function": "GiveWindowItemFromMenu",
                "params": []
            }
        },
        {
            "type": "spacer"
        },
        {
            "type": "section",
            "text": "$NQT_SEC_KEYS"
        },
        {
            "id": "TrackNearestHotkey",
            "type": "hotkey",
            "text": "$NQT_KEY_TRACK_NEAREST",
            "help": "$NQT_KEY_TRACK_NEAREST_HELP"
        },
        {
            "id": "ExcludeHotkey",
            "type": "hotkey",
            "text": "$NQT_KEY_EXCLUDE",
            "help": "$NQT_KEY_EXCLUDE_HELP"
        },
        {
            "id": "RestoreHotkey",
            "type": "hotkey",
            "text": "$NQT_KEY_RESTORE",
            "help": "$NQT_KEY_RESTORE_HELP"
        },
        {
            "id": "AutoTrackHotkey",
            "type": "hotkey",
            "text": "$NQT_KEY_AUTO_TRACK",
            "help": "$NQT_KEY_AUTO_TRACK_HELP"
        },
        {
            "id": "ShowQuestHotkey",
            "type": "hotkey",
            "text": "$NQT_KEY_SHOW_QUEST",
            "help": "$NQT_KEY_SHOW_QUEST_HELP"
        },
        {
            "id": "WindowHotkey",
            "type": "hotkey",
            "text": "$NQT_KEY_WINDOW",
            "help": "$NQT_KEY_WINDOW_HELP"
        },
        {
            "type": "spacer"
        },
        {
            "type": "section",
            "text": "$NQT_SEC_PICK"
        },
        {
            "type": "switcher",
            "text": "$NQT_INCLUDE_QUESTS",
            "help": "$NQT_INCLUDE_QUESTS_HELP",
            "valueOptions": {
                "sourceType": "GlobalValue",
                "sourceForm": "NearestQuestTracker.esp|80C"
            }
        },
        {
            "type": "switcher",
            "text": "$NQT_INCLUDE_NO_MARKER",
            "help": "$NQT_INCLUDE_NO_MARKER_HELP",
            "valueOptions": {
                "sourceType": "GlobalValue",
                "sourceForm": "NearestQuestTracker.esp|808"
            }
        },
        {
            "type": "switcher",
            "text": "$NQT_INCLUDE_STARTS",
            "help": "$NQT_INCLUDE_STARTS_HELP",
            "valueOptions": {
                "sourceType": "GlobalValue",
                "sourceForm": "NearestQuestTracker.esp|806"
            }
        },
        {
            "type": "switcher",
            "text": "$NQT_NO_SPOILERS",
            "help": "$NQT_NO_SPOILERS_HELP",
            "valueOptions": {
                "sourceType": "GlobalValue",
                "sourceForm": "NearestQuestTracker.esp|807"
            },
            "action": {
                "type": "CallFunction",
                "form": "NearestQuestTracker.esp|800",
                "scriptName": "NQT_MainScript",
                "function": "OnNoSpoilersChanged",
                "params": []
            }
        },
        {
            "type": "switcher",
            "text": "$NQT_INCLUDE_LOCATIONS",
            "help": "$NQT_INCLUDE_LOCATIONS_HELP",
            "valueOptions": {
                "sourceType": "GlobalValue",
                "sourceForm": "NearestQuestTracker.esp|80D"
            }
        },
        {
            "type": "switcher",
            "text": "$NQT_ALL_LOCATIONS",
            "help": "$NQT_ALL_LOCATIONS_HELP",
            "valueOptions": {
                "sourceType": "GlobalValue",
                "sourceForm": "NearestQuestTracker.esp|80A"
            }
        },
        {
            "type": "switcher",
            "text": "$NQT_INCLUDE_INTERIORS",
            "help": "$NQT_INCLUDE_INTERIORS_HELP",
            "valueOptions": {
                "sourceType": "GlobalValue",
                "sourceForm": "NearestQuestTracker.esp|80E"
            }
        },
        {
            "type": "switcher",
            "text": "$NQT_SKIP_OWNED_LOCKED",
            "help": "$NQT_SKIP_OWNED_LOCKED_HELP",
            "valueOptions": {
                "sourceType": "GlobalValue",
                "sourceForm": "NearestQuestTracker.esp|80F"
            }
        },
        {
            "type": "spacer"
        },
        {
            "type": "section",
            "text": "$NQT_SEC_MAIN"
        },
        {
            "type": "switcher",
            "text": "$NQT_UNTRACK_OTHERS",
            "help": "$NQT_UNTRACK_OTHERS_HELP",
            "valueOptions": {
                "sourceType": "GlobalValue",
                "sourceForm": "NearestQuestTracker.esp|801"
            }
        },
        {
            "type": "switcher",
            "text": "$NQT_AUTO_TRACK",
            "help": "$NQT_AUTO_TRACK_HELP",
            "valueOptions": {
                "sourceType": "GlobalValue",
                "sourceForm": "NearestQuestTracker.esp|804"
            },
            "action": {
                "type": "CallFunction",
                "form": "NearestQuestTracker.esp|800",
                "scriptName": "NQT_MainScript",
                "function": "OnAutoTrackChanged",
                "params": []
            }
        },
        {
            "type": "switcher",
            "text": "$NQT_NOTIFICATIONS",
            "help": "$NQT_NOTIFICATIONS_HELP",
            "valueOptions": {
                "sourceType": "GlobalValue",
                "sourceForm": "NearestQuestTracker.esp|802"
            }
        },
        {
            "type": "switcher",
            "text": "$NQT_SHOW_QUEST_IN_WINDOW",
            "help": "$NQT_SHOW_QUEST_IN_WINDOW_HELP",
            "valueOptions": {
                "sourceType": "GlobalValue",
                "sourceForm": "NearestQuestTracker.esp|810"
            }
        },
        {
            "type": "spacer"
        },
        {
            "type": "section",
            "text": "$NQT_SEC_EXCLUDED"
        },
        {
            "type": "dropdown",
            "text": "$NQT_RESTORE_PICK",
            "help": "$NQT_RESTORE_PICK_HELP",
            "valueOptions": {
                "sourceType": "PropertyValueInt",
                "sourceForm": "NearestQuestTracker.esp|800",
                "scriptName": "NQT_MainScript",
                "propertyName": "MCMRestoreChoice",
                "listFromProperty": {
                    "form": "NearestQuestTracker.esp|800",
                    "scriptName": "NQT_MainScript",
                    "propertyName": "ExcludedNames"
                }
            },
            "action": {
                "type": "CallFunction",
                "form": "NearestQuestTracker.esp|800",
                "scriptName": "NQT_MainScript",
                "function": "RestoreFromMenu",
                "params": [
                    "{value}"
                ]
            }
        },
        {
            "type": "button",
            "text": "$NQT_RESTORE_ALL",
            "help": "$NQT_RESTORE_ALL_HELP",
            "action": {
                "type": "CallFunction",
                "form": "NearestQuestTracker.esp|800",
                "scriptName": "NQT_MainScript",
                "function": "RestoreAll",
                "params": []
            }
        },
        {
            "type": "button",
            "text": "$NQT_RESTORE_QUESTS",
            "help": "$NQT_RESTORE_QUESTS_HELP",
            "action": {
                "type": "CallFunction",
                "form": "NearestQuestTracker.esp|800",
                "scriptName": "NQT_MainScript",
                "function": "RestoreKind",
                "params": [
                    1
                ]
            }
        },
        {
            "type": "button",
            "text": "$NQT_RESTORE_STARTS",
            "help": "$NQT_RESTORE_STARTS_HELP",
            "action": {
                "type": "CallFunction",
                "form": "NearestQuestTracker.esp|800",
                "scriptName": "NQT_MainScript",
                "function": "RestoreKind",
                "params": [
                    3
                ]
            }
        },
        {
            "type": "button",
            "text": "$NQT_RESTORE_LOCATIONS",
            "help": "$NQT_RESTORE_LOCATIONS_HELP",
            "action": {
                "type": "CallFunction",
                "form": "NearestQuestTracker.esp|800",
                "scriptName": "NQT_MainScript",
                "function": "RestoreKind",
                "params": [
                    4
                ]
            }
        },
        {
            "type": "button",
            "text": "$NQT_RESTORE_INTERIORS",
            "help": "$NQT_RESTORE_INTERIORS_HELP",
            "action": {
                "type": "CallFunction",
                "form": "NearestQuestTracker.esp|800",
                "scriptName": "NQT_MainScript",
                "function": "RestoreKind",
                "params": [
                    5
                ]
            }
        }
    ]
}
